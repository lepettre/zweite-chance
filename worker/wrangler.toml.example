name = "zc-helper"
main = "worker.mjs"
compatibility_date = "2025-01-01"

[triggers]
crons = ["5 * * * *"]          # stündlich um :05 UTC löst den Abruf aus

[[kv_namespaces]]
binding = "WL"
id = "<KV-Namespace-ID>"

[vars]
GH_REPO = "<konto>/<repo>"
TELEGRAM_CHAT_ID = "<chat-id>"
# Secrets (wrangler secret put ...): ACCESS_PASSWORD, GH_TOKEN, TG_SECRET
